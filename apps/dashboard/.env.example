# Local development: copy this file to .env.local in this directory
#   cp apps/dashboard/.env.example apps/dashboard/.env.local
# Then fill in your values.
#
# Replit: set each variable as a Replit Secret (Settings → Secrets).
# They are injected automatically as process.env — no file needed.

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── OpenAI / LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=""
LLM_PROVIDER="openai"
# Model name — use any OpenAI chat model (gpt-4o, gpt-4o-mini, gpt-5.2, etc.)
LLM_MODEL="gpt-4o"

# ── Storage (optional) ────────────────────────────────────────────────────────
# Overrides where chat sessions are persisted. Defaults to .data/ at repo root.
TANDEM_DATA_DIR=""

# ── Internal API guard (optional) ─────────────────────────────────────────────
# If set, the smoke-test scripts must send x-tandem-api-key: <value>.
# Leave blank for normal dashboard use — the proxy.ts middleware already
# requires Supabase auth for all dashboard API routes.
TANDEM_API_KEY=""

# ── Business allowlist (optional) ─────────────────────────────────────────────
# Comma-separated business slugs that may call /api/chat.
# Leave blank to allow all authenticated businesses.
TANDEM_ALLOWED_BUSINESS_IDS=""

# ── Supabase CLI (db:push / db:pull scripts only) ─────────────────────────────
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF=""
SUPABASE_DB_PASSWORD=""
