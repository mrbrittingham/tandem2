# Copy this file to apps/dashboard/.env.local (NOT the repo root)
# Next.js reads environment variables from apps/dashboard/.env.local
# In Replit, set these as Secrets (they are injected automatically as process.env)

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ── OpenAI / LLM ──────────────────────────────────────────────────────────────
OPENAI_API_KEY="YOUR_OPENAI_KEY_HERE"
LLM_PROVIDER="openai"
# Set this to the model you want to use (e.g. gpt-4o, gpt-4o-mini, gpt-5.2)
LLM_MODEL="gpt-4o"

# ── Storage ───────────────────────────────────────────────────────────────────
# Optional: override where chat sessions are stored. Defaults to .data/ at repo root.
TANDEM_DATA_DIR=""

# ── Internal API guard (optional) ─────────────────────────────────────────────
# If set, external API clients (smoke scripts) must send x-tandem-api-key: <value>
# Leave blank to disable. Do NOT set this in Replit Secrets unless you
# also send the header from the browser — it will block dashboard API calls.
TANDEM_API_KEY=""

# ── Business ID allowlist (optional) ──────────────────────────────────────────
# Comma-separated slugs allowed to call /api/chat. Leave blank to allow all.
TANDEM_ALLOWED_BUSINESS_IDS=""

# ── Supabase CLI (for db:push / db:pull scripts only) ─────────────────────────
SUPABASE_ACCESS_TOKEN=""
SUPABASE_PROJECT_REF=""
SUPABASE_DB_PASSWORD=""
